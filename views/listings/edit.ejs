<% layout('/layouts/boilerplate') %>
<body>
        <h3>Edit Listing</h3>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
        <input type="text" placeholder="Enter Title" name="listing[title]" value="<%= listing.title %>">
        <br><br>
        <textarea type="text" placeholder="Enter Description" name="listing[description]"><%= listing.description %></textarea>
        <br><br>
        <input type="text" placeholder="Enter Image URL/Link" name="listing[image.url]" value="<%= listing.image.url %>">
        <br><br>
        <input type="number" placeholder="Enter Price" name="listing[price]" value="<%= listing.price %>">
        <br><br>
        <input type="text" placeholder="Enter Country" name="listing[country]" value="<%= listing.country %>">
        <br><br>
        <input type="text" placeholder="Enter Location" name="listing[location]" value="<%= listing.location %>">
        <br><br>
        <button type="submit">Update</button>
    </form>
</body>